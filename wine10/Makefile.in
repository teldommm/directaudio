MODULE    = winedirectaudio.drv
UNIXLIB   = winedirectaudio.so
IMPORTS   = uuid ole32 user32 advapi32
DELAYIMPORTS = winmm
UNIX_LIBS = $(AAUDIO_LIBS) $(PTHREAD_LIBS) -llog
# Wine 10 mmdevapi has no midi_get_driver unixlib slot (added in Wine 11).
EXTRADEFS = -DWINE_MMDEVAPI_NO_MIDI_GET_DRIVER

SOURCES = \
	directaudio.c \
	mmdevdrv.c
